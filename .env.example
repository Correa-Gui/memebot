# ---- Modo ----
MODE=record                      # record | paper | live
LIVE_CONFIRM=                    # para live: I_UNDERSTAND_REAL_MONEY

# ---- Solana ----
INGEST_SOURCE=websocket          # websocket | grpc
RPC_URL=                         # RPC HTTP do seu provedor (mesma região da VPS)
RPC_WS_URL=                      # WebSocket do mesmo provedor, ex.: wss://...
GRPC_ENDPOINT=                   # opcional: Yellowstone gRPC, só se INGEST_SOURCE=grpc
GRPC_TOKEN=                      # opcional: token do provedor gRPC
JITO_BLOCK_ENGINE_URL=https://ny.mainnet.block-engine.jito.wtf   # ou frankfurt.mainnet...
KEYPAIR_PATH=./secrets/hot.keypair.json   # só usado em live; NUNCA commitar

# ---- Ingestão (Fase 1) ----
# Amostras/s de getTransaction p/ priority fee e tip Jito (aceita decimal; 0 = desliga). 0.2/s = 17 280
# amostras/dia; cada uma gasta 1 a 3 requisições HTTP (retry se a tx ainda não estiver indexada) →
# ~17k–52k créditos/dia no Helius (plano free = 1M/mês). Ver `pnpm status`.
INGEST_COST_SAMPLES_PER_SEC=0.2
PROTOCOL_CONFIG_INTERVAL_MS=600000   # releitura das contas de taxas/curva on-chain
IPFS_GATEWAY=https://ipfs.io/ipfs/   # para URIs ipfs:// dos metadados
METADATA_TIMEOUT_MS=5000
METADATA_CONCURRENCY=8
POOL_RESOLVE_CONCURRENCY=4         # resoluções de pool PumpSwap simultâneas por RPC
# Consultas getAccountInfo/s para resolver pools PumpSwap antigas (aceita fração). 0.1/s ≈ 6/min ≈ 260k/mês.
# Orçamento Helius free (1M créditos/mês ≈ 23/min no total): amostras de custo (~15–20/min a 0.2/s) +
# pools (6/min) + protocol_config (<1/min). A v0 só opera na curva: pool lenta só atrasa o mint de trades PumpSwap.
POOL_RESOLVE_PER_SEC=0.1
CLICKHOUSE_MEMORY_LIMIT_MB=2048    # usado pelo docker-compose (mem_limit), não lido pelo bot

# ---- Banco ----
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=memebot
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=memebot

# ---- Sinais (Fase 5) ----
TYPESAFE_API_KEY=                # Jev; deixe vazio para desativar
JEV_TIMEOUT_MS=600
X_API_BEARER=                    # fonte social; deixe vazio para desativar

# ---- Alertas ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Paper ----
PAPER_LATENCY_MS=800
PAPER_FAIL_RATE=0.10
PAPER_COST_MIN_SAMPLES=30                    # mínimo de amostras em tx_costs para usar a mediana × 1,5
PAPER_FALLBACK_PRIORITY_FEE_LAMPORTS=500000  # usado com menos amostras que o mínimo (conservador)
PAPER_FALLBACK_JITO_TIP_LAMPORTS=500000
PAPER_COST_LOOKBACK_HOURS=24                 # janela de tx_costs usada na mediana
PAPER_COST_RELOAD_MS=600000                  # recarga periódica das amostras de custo
